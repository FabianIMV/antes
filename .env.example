# Copia este archivo a `.env` y rellena los valores de tu proyecto Supabase.
# Ambas variables llevan el prefijo PUBLIC_ porque viajan al navegador: es
# correcto y necesario. La seguridad la da Row Level Security, no el secreto
# de la clave. NUNCA pongas aquí la service_role key.

PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Ruta base del sitio. En local déjalo vacío o "/".
# En GitHub Pages el workflow lo fija a "/<nombre-del-repo>".
# BASE_PATH=/antes
